# SuiteCRM Docker Environment Variables

# Database
DB_HOST=mysql
DB_NAME=suitecrm
DB_USER=suitecrm
DB_PASSWORD=suitecrm_password

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application
APP_URL=http://localhost:8080
APP_ENV=development

# MySQL Root (for phpMyAdmin and admin tasks)
MYSQL_ROOT_PASSWORD=root_password

# Additional settings (customize as needed)
TIMEZONE=UTC
MEMORY_LIMIT=256M
UPLOAD_MAX_FILESIZE=60M
